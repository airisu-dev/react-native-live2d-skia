{
  "expo": {
    "name": "react-native-live2d-skia",
    "slug": "react-native-live2d-skia",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "live2dskia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.airisu.rnlive2d",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.airisu.rnlive2d"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": ["arm64-v8a", "x86", "x86_64"]
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset",
      [
        "@airisu-dev/react-native-live2d-skia",
        {
          "cubismSdkPath": "./vendor/CubismSdkForNative"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4444654-e7ce-4f48-8ad1-e7f96aaa7d08"
      }
    }
  }
}
